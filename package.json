{
  "name": "watch-weather",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "720p landscape clock + Open-Meteo weather station (Pitești, Valea Mare, Arefu) for Android via Capacitor",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "android:configure": "node scripts/configure-android.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "capacitor:sync:after": "node scripts/configure-android.mjs"
  },
  "watchWeather": {
    "kioskLauncher": true
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/preferences": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "vite": "^6.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
